# /DATA/kuro/server.env — written by zima-onboard.sh with generated secrets. Mode 600.
BASE_URL=https://kuro.dormice.ai
DATABASE_URL=postgresql://kuro:<generated>@postgres:5432/kuro
KURO_SECRET_KEY=<32 random bytes, base64>
AUTH_PEPPER=<32 random bytes, base64>
SETUP_TOKEN=<random hex; first run only>
KURO_CR_URL=http://kuro-cr:8080
BACKUP_DIR=/data/backups
# Web Push (KURO-ADR-010): docker run --rm <kuro-server image> node dist/cli/main.js vapid-keys >> server.env
VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
VAPID_SUBJECT=mailto:owner@dormice.ai
# Sign in with D3 Auth — after importing deploy/d3auth-client.json into auth.d3cloud.io:
# D3AUTH_ISSUER=https://auth.d3cloud.io
# D3AUTH_CLIENT_ID=kuro
# D3AUTH_CLIENT_SECRET=<from the D3 Auth console>
# Anime catalog source (KURO-REQ-025): a GitHub repo publishing anime-offline-database weekly.
# Swap to athanasso/anime-offline-database if cedya77 goes stale.
KURO_CATALOG_REPO=cedya77/anime-offline-database
# AnimeSchedule.net application token (KURO-T-3.1): create one in your AnimeSchedule account settings, API tab.
# Without it, This Season shows what your Crunchyroll shows released this week.
# ANIMESCHEDULE_TOKEN=
