# Copy to .env. Never commit real values.
NODE_ENV=development
BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://kuro:kuro@127.0.0.1:5432/kuro
# 32 random bytes, base64. Encrypts the Crunchyroll refresh token (KURO-ADR-008).
KURO_SECRET_KEY=
# First-run setup gate (KURO-REQ-055). Remove after setup.
SETUP_TOKEN=
# Argon2id pepper (ported from Foreman's auth).
AUTH_PEPPER=
# Sign in with D3 Auth (OIDC).
D3AUTH_ISSUER=https://auth.d3cloud.io
D3AUTH_CLIENT_ID=
D3AUTH_CLIENT_SECRET=
# Web Push (VAPID).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Internal sidecar URL (compose network only).
KURO_CR_URL=http://kuro-cr:8080
# Catalog source: cedya77 | athanasso (KURO-ADR-002).
CATALOG_SOURCE=cedya77
ANIMESCHEDULE_TOKEN=
SYNC_TIMEZONE=America/New_York
