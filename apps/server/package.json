{
  "name": "kuro-server",
  "private": true,
  "version": "0.0.0",
  "description": "Kurō API, jobs and adapters; serves the web app as statics in production",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.13"
  }
}
