{
  "name": "kuro-server",
  "private": true,
  "version": "0.0.0",
  "description": "Kur\u014d API, jobs and adapters; serves the web app as statics in production",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "kuro": "node --import tsx src/cli/main.ts"
  },
  "dependencies": {
    "@d3cloudio/auth-client": "^0.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pg-boss": "^11.1.2",
    "pino": "^10.3.1",
    "prisma": "7.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.13"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
