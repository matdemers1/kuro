// Kurō schema v0 (KURO-T-0.2). The shape is foreman://KURO/data_model.
//
// Three rules this file exists to keep:
//   1. `play` is the History Vault and is append-only — a trigger in the migration refuses UPDATE
//      and DELETE on it (KURO-REQ-004). History Crunchyroll later forgets stays here.
//   2. Nothing derived lives in these v0 tables. Show status, progress and Up Next arrive as
//      rebuildable tables in KURO-T-1.5 (KURO-ADR-004).
//   3. The Crunchyroll refresh token is stored only as ciphertext (KURO-ADR-008).
//
// Auth tables follow Foreman's shape so its auth module ports without change (KURO-ADR-007).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────

enum AuthMethod {
  password
  oidc
}

enum ThrottleScope {
  account
  ip
}

/// Where the Crunchyroll link stands. `paused` means sync stopped on an expired/revoked session
/// and waits for a re-link (KURO-REQ-007); `blocked` means Cloudflare or a 401/403 refused it.
enum CrConnectionState {
  linked
  paused
  blocked
}

enum SyncKind {
  backfill
  delta
}

enum SyncStatus {
  running
  succeeded
  failed
}

enum CrParentType {
  series
  movie_listing
}

// ─── The owner and their sign-in ─────────────────────────────────────────

/// Kurō has one owner (KURO-REQ-055), but the table does not pretend otherwise: a second row is
/// refused by the setup flow, not by the schema.
model User {
  id          String @id @default(uuid(7)) @db.Uuid
  email       String @unique
  displayName String @map("display_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential   Credential?
  identities   Identity[]
  sessions     Session[]
  crConnection CrConnection?
  changes      ChangeLog[]

  @@map("user")
}

model Credential {
  userId String @id @map("user_id") @db.Uuid

  passwordHash      String    @map("password_hash")
  passwordUpdatedAt DateTime  @default(now()) @map("password_updated_at") @db.Timestamptz(6)
  /// Encrypted. Null until TOTP is enrolled.
  totpSecret        String?   @map("totp_secret")
  totpConfirmedAt   DateTime? @map("totp_confirmed_at") @db.Timestamptz(6)
  /// Last accepted TOTP step, so a code cannot be replayed inside its window.
  totpLastStep      BigInt?   @map("totp_last_step")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credential")
}

/// A Sign in with D3 Auth identity. Linked by (iss, sub), never by email (GL-001).
model Identity {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  iss         String
  sub         String
  claims      Json?
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([iss, sub])
  @@index([userId])
  @@map("identity")
}

model Session {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The cookie carries the token; only its hash is stored, so a leaked row cannot be replayed.
  tokenHash  String     @unique @map("token_hash")
  method     AuthMethod
  idTokenSub String?    @map("id_token_sub")
  ip         String?
  userAgent  String?    @map("user_agent")
  lastSeenAt DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("session")
}

model AuthThrottle {
  scope ThrottleScope
  key   String

  failures      Int      @default(0)
  nextAllowedAt DateTime @map("next_allowed_at") @db.Timestamptz(6)
  lastFailureAt DateTime @default(now()) @map("last_failure_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@map("auth_throttle")
}

// ─── Crunchyroll link and sync ───────────────────────────────────────────

model CrConnection {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// Crunchyroll's account and profile IDs. Never committed anywhere (KURO-REQ-057).
  accountId String  @map("account_id")
  profileId String? @map("profile_id")
  /// Kurō's own stable device ID, used for the password grant and every refresh (KURO-ADR-001).
  deviceId  String  @map("device_id")

  /// AES-256-GCM ciphertext of the refresh token, base64; the key lives only in KURO_SECRET_KEY.
  refreshTokenCiphertext String @map("refresh_token_ciphertext")
  refreshTokenNonce      String @map("refresh_token_nonce")

  state         CrConnectionState @default(linked)
  stateReason   String?           @map("state_reason")
  /// The newest date_played seen; delta sync stops at the first page wholly older than this.
  highWaterMark DateTime?         @map("high_water_mark") @db.Timestamptz(6)
  lastSuccessAt DateTime?         @map("last_success_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns SyncRun[]

  @@map("cr_connection")
}

model SyncRun {
  id             String     @id @default(uuid(7)) @db.Uuid
  crConnectionId String     @map("cr_connection_id") @db.Uuid
  kind           SyncKind
  status         SyncStatus @default(running)

  /// Backfill checkpoint: the last history page fully stored, so a restart resumes after it.
  lastPage      Int     @default(0) @map("last_page")
  /// The page size `last_page` counts in; the resume offset is their product.
  pageSize      Int     @default(100) @map("page_size")
  pagesTotal    Int?    @map("pages_total")
  playsObserved Int     @default(0) @map("plays_observed")
  playsNew      Int     @default(0) @map("plays_new")
  error         String?

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  /// When the catalog was resolved and derived state rebuilt after this run: until then Up Next is stale.
  derivedAt  DateTime? @map("derived_at") @db.Timestamptz(6)

  crConnection CrConnection @relation(fields: [crConnectionId], references: [id], onDelete: Cascade)
  plays        Play[]

  @@index([crConnectionId, startedAt])
  @@map("sync_run")
}

/// The History Vault: one row per watch-history observation, append-only (KURO-REQ-004). The
/// same episode played again on a later date is a new row — that is how rewatches are seen.
model Play {
  id          String   @id @default(uuid(7)) @db.Uuid
  crEpisodeId String   @map("cr_episode_id")
  /// Crunchyroll's series or movie listing the episode belongs to.
  crParentId   String       @map("cr_parent_id")
  crParentType CrParentType @map("cr_parent_type")
  datePlayed   DateTime     @map("date_played") @db.Timestamptz(6)
  playheadS    Int          @map("playhead_s")
  fullyWatched Boolean      @map("fully_watched")
  /// The raw entry as Crunchyroll returned it, so later parsing fixes never need a re-fetch.
  raw          Json

  syncRunId  String   @map("sync_run_id") @db.Uuid
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  syncRun SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Restrict)

  @@unique([crEpisodeId, datePlayed])
  @@index([datePlayed])
  @@index([crParentId])
  @@map("play")
}

// ─── Crunchyroll catalog mirror (cache of what plays point at) ────────────

model CrSeries {
  id          String  @id
  title       String
  slugTitle   String? @map("slug_title")
  description String?
  raw         Json
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  seasons CrSeason[]

  @@map("cr_series")
}

/// One Crunchyroll season. Crunchyroll makes a separate season per audio language, so a dub of
/// the same story is a second row here (KURO-REQ-012 folds them).
model CrSeason {
  id                   String   @id
  seriesId             String   @map("series_id")
  title                String
  seasonNumber         Int      @map("season_number")
  seasonSequenceNumber Float?   @map("season_sequence_number")
  audioLocale          String?  @map("audio_locale")
  raw                  Json
  fetchedAt            DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  series   CrSeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes CrEpisode[]

  @@index([seriesId])
  @@map("cr_season")
}

model CrEpisode {
  id             String    @id
  seasonId       String    @map("season_id")
  title          String
  episodeNumber  Int?      @map("episode_number")
  sequenceNumber Float     @map("sequence_number")
  durationS      Int       @map("duration_s")
  audioLocale    String?   @map("audio_locale")
  airDate        DateTime? @map("air_date") @db.Timestamptz(6)
  /// From static skip-events where Crunchyroll publishes them (KURO-REQ-011).
  creditsStartS  Int?      @map("credits_start_s")
  /// When skip-events were last asked for, found or not — so a missing file is not re-fetched.
  skipCheckedAt  DateTime? @map("skip_checked_at") @db.Timestamptz(6)
  /// One Canonical Episode regardless of dub; set by resolve in KURO-T-1.4.
  canonicalId    String?   @map("canonical_id")
  /// Every audio language this episode is out in, from its versions — what dub lag counts (KURO-T-3.3).
  audioLocales   String[]  @default([]) @map("audio_locales")
  raw            Json
  fetchedAt      DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  season CrSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
  @@index([canonicalId])
  @@map("cr_episode")
}

// ─── Derived state (KURO-ADR-004) — rebuilt whole, never edited ───────────

enum ShowStatus {
  plan_to_watch
  watching
  caught_up
  paused
  completed
  dropped
  rewatching
}

/// One row per Show, recomputed from the vault, the catalog and the owner's own choices. In Phase 1
/// a Show is a Crunchyroll series (`show_key` = `cr:<series id>`); Phase 2 swaps in catalog Shows
/// without changing this table's shape.
model ShowState {
  showKey         String     @id @map("show_key")
  title           String
  status          ShowStatus
  watchedEpisodes Int        @map("watched_episodes")
  totalEpisodes   Int        @map("total_episodes")
  remainingS      Int        @map("remaining_s")
  /// Last watched episode's season and number, for "S2 · E6" — the canonical episode's.
  currentSeason   Int?       @map("current_season")
  currentEpisode  Int?       @map("current_episode")
  nextSeason      Int?       @map("next_season")
  nextEpisode     Int?       @map("next_episode")
  /// The Crunchyroll episode the Watch link opens: the next episode in the owner's audio language.
  nextCrEpisodeId String?    @map("next_cr_episode_id")
  nextAudioLocale String?    @map("next_audio_locale")
  nextTitle       String?    @map("next_title")
  /// The next episode became available after the owner last watched (a new dub episode, say).
  nextIsNew       Boolean    @default(false) @map("next_is_new")
  /// The next episode is in a later season than the last one watched.
  nextIsNewSeason Boolean    @default(false) @map("next_is_new_season")
  /// Episodes out in the original but not yet in the owner's dub, after the last dubbed one.
  dubLag          Int        @default(0) @map("dub_lag")
  /// An announced or airing sequel of the Show's last Season (KURO-T-3.4): the catalog entry.
  comingEntryId   String?    @map("coming_entry_id")
  lastPlayedAt    DateTime?  @map("last_played_at") @db.Timestamptz(6)
  derivedAt       DateTime   @map("derived_at") @db.Timestamptz(6)

  @@index([status])
  @@map("show_state")
}

/// The owner's own choices about a Show — inputs to derivation, never outputs (KURO-ADR-004).
model ShowPreference {
  showKey   String   @id @map("show_key")
  pinned    Boolean  @default(false)
  /// The owner's own status — plan_to_watch or dropped, the two never derived (KURO-REQ-033).
  status    String?
  /// When it was set: a play after a drop means the owner came back to the Show.
  statusAt  DateTime? @map("status_at") @db.Timestamptz(6)
  /// Why it was dropped (KURO-REQ-043): pacing, not_for_me or got_busy.
  dropReason String?  @map("drop_reason")
  /// Leave filler out of the Show's main line: Up Next goes past it, and it never blocks Completed (KURO-T-5.3).
  skipFiller Boolean  @default(false) @map("skip_filler")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("show_preference")
}

// ─── Alerts (KURO-REQ-020, KURO-ADR-010) ──────────────────────────────────

/// One installed PWA that accepted Web Push. Dropped when the push service says it is gone.
model PushSubscription {
  id        String    @id @default(uuid(7)) @db.Uuid
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?   @map("user_agent")
  lastOkAt  DateTime? @map("last_ok_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("push_subscription")
}

/// Every alert ever sent, keyed so the same event never notifies twice.
model Alert {
  key       String   @id
  title     String
  body      String
  url       String?
  delivered Int      @default(0)
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@map("alert")
}

// ─── Change log (KURO-REQ-022) ───────────────────────────────────────────

/// Every user mutation, with what it replaced, kept forever. Undo is a change-log operation: it
/// restores `before` and writes its own row, pointing at the one it reversed.
model ChangeLog {
  id       String  @id @default(uuid(7)) @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  entity   String
  entityId String  @map("entity_id")
  action   String
  before   Json?
  after    Json?
  undoesId String? @unique @map("undoes_id") @db.Uuid
  at       DateTime @default(now()) @db.Timestamptz(6)

  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  undoes ChangeLog? @relation("Undo", fields: [undoesId], references: [id], onDelete: Restrict)
  undoneBy ChangeLog? @relation("Undo")

  @@index([entity, entityId])
  @@index([at])
  @@map("change_log")
}

// ─── Catalog (KURO-ADR-002, KURO-REQ-025, KURO-REQ-026) ───────────────────

/// One imported release of anime-offline-database. The newest one's age drives the stale alert.
model CatalogRelease {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// owner/name on GitHub — cedya77/anime-offline-database by default, swappable by env.
  repo        String
  tag         String
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  importedAt  DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  entries     Int
  added       Int
  retired     Int

  @@unique([repo, tag])
  @@map("catalog_release")
}

/// One catalog record: a TV cour, movie, OVA, ONA or special. The id is stable across releases —
/// an entry whose sources change is matched back to its row through any source URL they share.
model CatalogEntry {
  /// `anilist:<id>`, else `mal:<id>`, else `src:<first source URL>` — fixed when first seen.
  id          String    @id
  title       String
  /// TV, MOVIE, OVA, ONA, SPECIAL or UNKNOWN.
  type        String
  episodes    Int
  /// FINISHED, ONGOING, UPCOMING or UNKNOWN.
  status      String
  season      String?
  seasonYear  Int?      @map("season_year")
  durationS   Int?      @map("duration_s")
  picture     String?
  thumbnail   String?
  synonyms    String[]
  sources     String[]
  /// Untyped related entries, as provider URLs; AniList supplies the typed relations (KURO-T-2.2).
  related     String[]
  tags        String[]
  studios     String[]
  anilistId   Int?      @map("anilist_id")
  malId       Int?      @map("mal_id")
  /// The release's mean score across providers, 1–10: the recommender's quality prior (KURO-T-4.4).
  score       Float?
  /// Absent from the newest release: kept, so mappings to it surface for a remap instead of breaking.
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)
  releaseId   String    @map("release_id") @db.Uuid
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([anilistId])
  @@index([malId])
  @@index([retiredAt])
  @@map("catalog_entry")
}

/// AniList's record for a catalog entry the owner has, fetched once and kept forever (KURO-ADR-002):
/// typed relations for franchise grouping, and external links — Crunchyroll's among them — for matching.
model AnilistMedia {
  anilistId Int      @id @map("anilist_id")
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("anilist_media")
}

/// A Crunchyroll season's episode range → a catalog entry (KURO-ADR-003): catalog episode =
/// Crunchyroll episode number + offset. The matcher writes `auto` rows; the owner's `confirmed` and
/// `override` rows are never touched by automation.
model Mapping {
  id             String   @id @default(uuid(7)) @db.Uuid
  crSeasonId     String   @map("cr_season_id")
  epFrom         Int      @map("ep_from")
  epTo           Int      @map("ep_to")
  catalogEntryId String?  @map("catalog_entry_id")
  offset         Int
  /// auto (the matcher), confirmed (the owner accepted it), override (the owner changed it).
  source         String   @default("auto")
  /// accepted, or review — waiting on the owner.
  status         String
  /// strong or weak, as the matcher judged it.
  confidence     String
  signals        String[]
  /// For the review queue: catalog entry ids worth showing, best first.
  candidates     String[]
  /// What the matcher proposed, kept when the owner confirms or overrides — known-wrong is counted from it.
  autoEntryId    String?  @map("auto_entry_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([crSeasonId, epFrom])
  @@index([status])
  @@index([catalogEntryId])
  @@map("mapping")
}

/// A Show (KURO-T-2.5): derived, rebuilt whole with show_state — never edited (KURO-ADR-004).
/// `show:<first season's catalog entry>` when matched, `cr:<series>` while it is not.
model Show {
  showKey      String   @id @map("show_key")
  title        String
  /// `fr:<earliest show's key>`: the Shows AniList's relations tie together.
  franchiseKey String   @map("franchise_key")
  /// The Crunchyroll series it is made of — one, or several when Crunchyroll split it.
  seriesIds    String[] @map("series_ids")
  derivedAt    DateTime @map("derived_at") @db.Timestamptz(6)

  items ShowItem[]

  @@index([franchiseKey])
  @@map("show")
}

/// A Season or an Extra of a Show, in watch order (KURO-REQ-031). Derived.
model ShowItem {
  showKey        String  @map("show_key")
  position       Int
  catalogEntryId String  @map("catalog_entry_id")
  /// season or extra.
  kind           String
  /// Extras are optional: they never block Completed.
  required       Boolean

  show Show @relation(fields: [showKey], references: [showKey], onDelete: Cascade)

  @@id([showKey, position])
  @@index([catalogEntryId])
  @@map("show_item")
}

/// The owner's corrections to grouping (KURO-T-2.6): merge, split, reorder, attach. Inputs to
/// derivation — anchored on Crunchyroll series and catalog entries, so they survive every sync and
/// catalog import — applied in order of creation.
model Override {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// merge, split, reorder or attach.
  kind      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("override")
}

/// A series on the owner's Crunchyroll watchlist or a Crunchylist (KURO-T-3.5): a snapshot, replaced
/// on every sync. A series here with nothing watched is a Show with status Plan to watch.
model PlanEntry {
  crSeriesId String   @map("cr_series_id")
  /// watchlist, or crunchylist:<list id>.
  source     String
  listTitle  String?  @map("list_title")
  syncedAt   DateTime @map("synced_at") @db.Timestamptz(6)

  @@id([crSeriesId, source])
  @@map("plan_entry")
}

/// One row of an AnimeSchedule.net timetable for a week (KURO-T-3.1): replaced whole per week.
model ScheduleEntry {
  /// ISO week, as AnimeSchedule numbers them: "2026-W43".
  week          String
  route         String
  /// dub, sub or raw.
  airType       String    @map("air_type")
  episodeNumber Int       @default(0) @map("episode_number")
  episodeDate   DateTime? @map("episode_date") @db.Timestamptz(6)
  title         String
  english       String?
  episodes      Int?
  status        String?
  delayedUntil  DateTime? @map("delayed_until") @db.Timestamptz(6)
  fetchedAt     DateTime  @map("fetched_at") @db.Timestamptz(6)

  @@id([week, route, airType, episodeNumber])
  @@index([route])
  @@map("schedule_entry")
}

/// What an AnimeSchedule route is in the catalog's terms, asked once and kept.
model ScheduleAnime {
  route     String   @id
  anilistId Int?     @map("anilist_id")
  malId     Int?     @map("mal_id")
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(6)

  @@index([anilistId])
  @@map("schedule_anime")
}

/// The owner's 1–10 rating of a Show, or of one of its Seasons (KURO-REQ-041). Inputs, never derived.
model Rating {
  /// `show:<show key>` for the Show, or `season:<catalog entry id>` for one Season.
  target    String   @id
  score     Int
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rating")
}

/// The owner's free-text note on a Show (KURO-REQ-044).
model ShowNote {
  showKey   String   @id @map("show_key")
  text      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("show_note")
}

/// A rewatch of a Show (KURO-T-4.2): derived from plays — a replay after the end opens one, replaying
/// the last episode closes it — and rebuilt whole with show_state.
model Rewatch {
  showKey   String    @map("show_key")
  startedAt DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  @@id([showKey, startedAt])
  @@map("rewatch")
}

/// The owner's rewatch queue (KURO-REQ-042): ordered, with an optional reason and starting Season.
model RewatchQueueItem {
  showKey      String   @id @map("show_key")
  position     Int
  reason       String?
  /// The Season to start from, as a catalog entry id; null starts at the beginning.
  startEntryId String?  @map("start_entry_id")
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  @@index([position])
  @@map("rewatch_queue")
}

/// A recommendation the owner said Not interested to (KURO-REQ-046): hidden from Discover and season
/// picks, and its tags and studios weigh similar Shows down.
model RecDismissal {
  catalogEntryId String   @id @map("catalog_entry_id")
  at             DateTime @default(now()) @db.Timestamptz(6)

  @@map("rec_dismissal")
}

/// The owner's edit to one term of the taste profile (KURO-REQ-048): `tag:<name>` or `studio:<name>`,
/// boosted, lowered or muted. Absent means the term weighs what the history says.
model TasteTerm {
  term      String   @id
  /// boost | lower | mute
  adjust    String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("taste_term")
}

/// A show's episode guide on animefillerlist.com (KURO-T-5.3, KURO-ADR-012): fetched only for the
/// owner's long Shows, weekly at most, a request every ten seconds.
model FillerList {
  slug      String          @id
  /// "English (Romaji)", as the site names it: what links it to a Season.
  title     String
  fetchedAt DateTime        @map("fetched_at") @db.Timestamptz(6)
  episodes  FillerEpisode[]

  @@map("filler_list")
}

/// One episode of a filler list, numbered as the site numbers the whole run.
model FillerEpisode {
  slug   String
  number Int
  /// canon | mixed | filler | anime_canon
  kind   String
  list   FillerList @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@id([slug, number])
  @@map("filler_episode")
}

/// One nightly backup (KURO-T-6.2): the dump, and whether restoring it into a scratch database gave
/// the same Up Next as the live one. The health panel reads the newest.
model BackupRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  file       String?
  sizeBytes  BigInt?   @map("size_bytes")
  /// ok, failed (the restore differed) or error (the dump or restore did not run).
  check      String
  detail     String?
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@map("backup_run")
}

// ─── Shared lists ─────────────────────────────────────────────────────────

/// A list of Shows the owner recommends, readable without signing in by anyone holding its link. The
/// link's token is the only key: turning sharing off or making a new link kills the old one.
model ShareList {
  id        String          @id @default(uuid(7)) @db.Uuid
  title     String
  /// A word at the top of the list: who it is for, or where to start.
  intro     String?
  /// 32 random bytes, base64url; null while sharing is off.
  token     String?         @unique
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     ShareListItem[]

  @@map("share_list")
}

/// One Show on a shared list, in the owner's order, with an optional note for the reader.
model ShareListItem {
  listId   String    @map("list_id") @db.Uuid
  showKey  String    @map("show_key")
  position Int
  note     String?
  list     ShareList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([listId, showKey])
  @@index([listId, position])
  @@map("share_list_item")
}
