{
  "name": "kuro",
  "private": true,
  "version": "0.0.0",
  "description": "Kur\u014d \u2014 a self-hosted, single-user anime tracker: your Crunchyroll history, by show not by season",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test scripts/scan-personal-data.test.mjs && pnpm -r --filter '!e2e' --if-present test",
    "build": "pnpm -r --if-present build",
    "scan": "node scripts/scan-personal-data.mjs",
    "e2e": "pnpm --filter e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
